# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page. Both values are safe in client code: the anon key
# carries no privileges of its own, and every table it can reach is gated by
# the Row Level Security policies in supabase/migrations.
#
# Secrets (Plaid, LLM keys) never go in this file — they are Edge Function
# environment variables, set with `supabase secrets set`.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
